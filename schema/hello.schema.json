{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.droidthumb.com/hello.json",
  "title": "Hello",
  "description": "device -> server, sent once per connection to open the handshake. `apk_version` is the app's own version (semver) — the 'app version' the server logs per connection. `android_version` and `device_model` are optional so an app built before they existed still validates; the server records them for compatibility decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocol_version", "apk_version", "device_id", "capabilities", "mode", "flow_manifest"],
  "properties": {
    "type": { "const": "hello" },
    "protocol_version": { "type": "integer", "minimum": 1 },
    "apk_version": { "type": "string" },
    "android_version": { "type": "integer", "minimum": 1, "description": "Android API level (Build.VERSION.SDK_INT), e.g. 34 for Android 14." },
    "device_model": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Hardware model (Build.MANUFACTURER + Build.MODEL). Diagnostic only." },
    "device_id": { "type": "string" },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "mode": { "type": "string", "enum": ["live", "unattended"] },
    "flow_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": { "id": { "type": "string" }, "version": { "type": "integer" } }
      }
    }
  }
}
