{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.droidthumb.com/flow.json",
  "title": "Flow",
  "description": "A saved, replayable sequence of steps (design doc §7.1), trimmed for the MVP: steps are restricted to the 7 ops plan 01 §5.1 exposes on the MCP surface (a closed set for now, not the full §7.2 vocabulary), and there is no branching, call_flow, or signing yet. `save_flow` produces these; `run_flow` replays them server-side, step by step, against the device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "params", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": { "type": "string" }
      }
    },
    "params": {
      "type": "array",
      "items": { "$ref": "#/$defs/param" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/flow_step" }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fragile": {
          "type": "boolean",
          "description": "True when at least one step's params ended up coordinate-only (`at`, no `selector`) — the device found nothing identifiable under the tapped point when the flow was saved, so that step can't self-heal on replay the way a selector-based tap can (M3, droidthumb-server/docs/decisions-log.md)."
        },
        "fragile_reason": { "type": "string" }
      }
    }
  },
  "$defs": {
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["string", "number", "boolean"] },
        "secret": { "type": "boolean" },
        "required": { "type": "boolean" }
      }
    },
    "flow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "op"],
      "properties": {
        "id": { "type": "string" },
        "op": {
          "type": "string",
          "enum": ["read_screen", "tap", "type_text", "scroll_find", "key", "launch_app", "wait_until"]
        },
        "params": { "type": "object" }
      }
    }
  }
}
